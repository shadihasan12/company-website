APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cleancody
DB_USERNAME=cleancody
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"


VITE_APP_NAME="${APP_NAME}"

# Site identity — see config/site.php
SITE_NAME="Clean Cody"
SITE_LEGAL_NAME="Clean Cody"
SITE_DOMAIN=cleancody.com
SITE_EMAIL=cleancodyteam@gmail.com
SITE_PHONE="+961 76 928 097"
SITE_WHATSAPP=96176928097
SITE_CITY=Beirut
SITE_COUNTRY=Lebanon
SITE_COUNTRY_CODE=LB

SOCIAL_LINKEDIN=
SOCIAL_GITHUB=
SOCIAL_X=
SOCIAL_INSTAGRAM=
SOCIAL_FACEBOOK=
SOCIAL_YOUTUBE=

REVIEWS_CLUTCH=
REVIEWS_GOODFIRMS=
REVIEWS_GOOGLE=

# Lead capture
LEADS_NOTIFY_EMAIL=

# Cloudflare Turnstile (optional — honeypot + rate limiting used without it)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# SEO — leave unset to index only in production
SITE_INDEXABLE=

# Analytics — nothing loads until one of these is set, and never outside production
GA4_MEASUREMENT_ID=
PLAUSIBLE_DOMAIN=
GOOGLE_SITE_VERIFICATION=

# Cloudflare R2 (S3-compatible). AWS_DEFAULT_REGION is always "auto" for R2,
# and R2 requires path-style addressing. AWS_ENDPOINT is the account endpoint
# WITHOUT the bucket name; the bucket is named separately in AWS_BUCKET.
# Uploaded media is served from Cloudflare R2; private app storage stays local.
MEDIA_DISK=s3
FILESYSTEM_DISK=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=cleancody-media
AWS_ENDPOINT=https://1e4f118b7721bf69923729b8eefd98cd.r2.cloudflarestorage.com
AWS_URL=https://pub-fe0e043997184ad192053daedebb524f.r2.dev
AWS_USE_PATH_STYLE_ENDPOINT=true
